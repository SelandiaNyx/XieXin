# Rust build output
target/
src-tauri/target/

# Local Rust toolchains and bundled build tools
.cargo/
.rustup/
.tooling/mingw/
.tooling/*.exe

# Local environment and editor files
.env
.env.*
.idea/
# .vscode：只共享与仓库强相关的团队配置（插件推荐 / 任务 / 调试 / 工作区设置），
# 个人偏好、snippets、本地历史仍然不入库。
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.self-check-data/
.sc/
.sm/
.relcheck/
.smoke-data/
.probe/
release/

# Verification screenshots. Only the numbered, curated ones are kept in the
# repository (e.g. .shots/01-app.png); everything else is local scratch work.
.shots/*
!.shots/[0-9][0-9]-*.png

# OS metadata
Thumbs.db
Desktop.ini
