# 维护者：SelandiaNyx
# Arch Linux / AUR 包描述文件。
#
# 为什么用预编译包而不是从源码构建：CI 已经在 Arch 容器里构建并跑过无头自检，
# 这里直接装那个产物，用户就不需要安装 Rust 工具链和整套 -dev 依赖（webkit2gtk-4.1
# 的开发包在 Arch 上要拉几百 MB）。运行期依赖仍然由 pacman 负责。
#
# 用法（在包含本文件的目录里）：
#   makepkg -si
#
# 发布新版本时需要同步更新：pkgver、sha256sums（用 `updpkgsums` 自动填）。

pkgname=xiexin-bin
pkgver=0.1.1
pkgrel=1
pkgdesc='写心 · 本地小说写作工作台（离线优先的中文长篇写作工具）'
arch=('x86_64')
url='https://github.com/SelandiaNyx/XieXin'
license=('GPL-3.0-only')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libsoup3'
  'glib2'
  'cairo'
  'pango'
  'gdk-pixbuf2'
  'librsvg'
)
provides=('xiexin')
conflicts=('xiexin')
options=('!strip')   # 产物已经 strip 过，再 strip 一次没有意义

source=("${pkgname%-bin}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/XieXin-linux-${pkgver}.tar.gz")
sha256sums=('1883d5c3338faf0c6101a65b3a0cb17cfc1c8f91ce5a308df05bcea8b56a9b52')

package() {
  local srcdir_name="XieXin-linux-${pkgver}"

  # 主程序：包内叫 HeartWrite，安装后统一为 xiexin，避免和文件名混淆
  install -Dm755 "${srcdir}/${srcdir_name}/HeartWrite" "${pkgdir}/usr/bin/xiexin"

  # 桌面入口
  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/xiexin.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=写心
Name[en]=HeartWrite
Comment=本地小说写作工作台
Comment[en]=Offline novel writing workspace
Exec=xiexin
Icon=xiexin
Terminal=false
Categories=Office;WordProcessor;
MimeType=text/plain;
Keywords=novel;writing;小说;写作;
EOF

  # 图标
  install -Dm644 "${srcdir}/${srcdir_name}/HeartWrite.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/xiexin.png"

  # 许可证
  install -Dm644 "${srcdir}/${srcdir_name}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
